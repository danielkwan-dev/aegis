DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis

# Leave unset to auto-detect via `shutil.which("tesseract")`.
TESSERACT_CMD=

# Path to the fine-tuned YOLOv8n signage detector (quantized ONNX), once the
# Colab training run in ml_training/vision/ has produced one. Leave unset to
# fall back to whole-image OCR.
VISION_MODEL_PATH=

SESSION_COOKIE_NAME=aegis_session_id
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
